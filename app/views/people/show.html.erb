<div class="card">
  <div class="card-header">
    <span class="badge badge-<%= state_batches[@person.state_name] %>"><%= @person.state_name.to_s.humanize %></span>
    <%= @person.name %> (<%= render_person_role(@person) %>)
  </div>
  <div class="card-body">
    <%= link_to 'Edit', edit_person_path(@person), class: 'btn btn-primary active float-right' %>
    <p>
      <strong>Name:</strong>
      <%= @person.name %>
    </p>

    <p>
      <strong>Pronoun:</strong>
      <%= @person.pronoun %>
    </p>

    <p>
      <strong>Email:</strong>
      <%= link_to @person.email, 'mailto:' + @person.email %>
    </p>

    <p>
      <strong>About:</strong><br>
      <%= simple_format(@person.about) %>
    </p>
    <p>
      <strong>Tags:</strong>
      <%= @person.tag_list %>
    </p>
    <p>
      <strong>Conference Ticket:</strong>
      <%= render_conference_ticket_badge(@person) %>
    </p>
    <% if @person.group %>
    <p>
      <strong>Group:</strong>
      <%= link_to @person.group.label, @person.group %>
    </p>
    <% end %>
  </div>
</div>

<div class="card mt-4">
  <div class="card-header">
    <h5 class="mb-0">Communication History</h5>
  </div>
  <div class="card-body">
    <% if @person.emails.any? %>
      <table class="table table-sm table-hover">
        <thead>
          <tr>
            <th>Date</th>
            <th>Direction</th>
            <th>Subject</th>
            <th>From</th>
            <th>To</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @person.emails.recent.limit(20).each do |email| %>
            <tr>
              <td><%= email.sent_at&.strftime("%Y-%m-%d %H:%M") || "Unknown" %></td>
              <td>
                <span class="badge badge-<%= email.inbound? ? 'info' : 'success' %>">
                  <%= email.direction %>
                </span>
              </td>
              <td><%= truncate(email.subject, length: 50) %></td>
              <td><%= truncate(email.from_address, length: 40) %></td>
              <td><%= truncate(email.to_addresses, length: 40) %></td>
              <td>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-toggle="modal" data-target="#emailModal"
                  data-email-date="<%= email.sent_at&.strftime("%Y-%m-%d %H:%M") || "Unknown" %>"
                  data-email-direction="<%= email.direction %>"
                  data-email-subject="<%= h email.subject %>"
                  data-email-from="<%= h email.from_address %>"
                  data-email-to="<%= h email.to_addresses %>"
                  data-email-body="<%= h email.body_plain %>">
                  View
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @person.emails.count > 20 %>
        <p class="text-muted">Showing 20 of <%= @person.emails.count %> emails.</p>
      <% end %>
    <% else %>
      <p class="text-muted mb-0">No emails found for this person.</p>
    <% end %>
  </div>
</div>

<div class="modal fade" id="emailModal" tabindex="-1" role="dialog" aria-labelledby="emailModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="emailModalLabel">Email Details</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <dl class="row mb-0">
          <dt class="col-sm-2">Date</dt>
          <dd class="col-sm-10" id="emailModalDate"></dd>

          <dt class="col-sm-2">Direction</dt>
          <dd class="col-sm-10" id="emailModalDirection"></dd>

          <dt class="col-sm-2">Subject</dt>
          <dd class="col-sm-10" id="emailModalSubject"></dd>

          <dt class="col-sm-2">From</dt>
          <dd class="col-sm-10" id="emailModalFrom"></dd>

          <dt class="col-sm-2">To</dt>
          <dd class="col-sm-10" id="emailModalTo"></dd>
        </dl>
        <hr>
        <pre id="emailModalBody" class="mb-0" style="white-space: pre-wrap; word-wrap: break-word; font-family: inherit;"></pre>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<script>
  $('#emailModal').on('show.bs.modal', function (event) {
    var button = $(event.relatedTarget);
    var modal = $(this);

    modal.find('#emailModalDate').text(button.data('email-date'));
    modal.find('#emailModalDirection').text(button.data('email-direction'));
    modal.find('#emailModalSubject').text(button.data('email-subject'));
    modal.find('#emailModalFrom').text(button.data('email-from'));
    modal.find('#emailModalTo').text(button.data('email-to'));
    modal.find('#emailModalBody').text(button.data('email-body') || '(No body content)');
  });
</script>

<div class="row mt-12">
  <div class="col-md-12 mt-4 mb-4">
    <div class="border p-4">
      <h4 class="mb-4">Manage Person</h4>
      <div class="d-flex" style="gap:1rem;" role="group">
        <%= link_to 'Set to waiting', { action: "change_state", random_id: @person, state: 4 }, { class: 'btn btn-warning btn-lg' } %>
        <%= link_to 'Manage Ticket state', edit_conference_ticket_path(@person.verification_token), class: 'btn btn-info btn-lg' %>
        <% if !current_person.nil? && (@person.isgodmother? || @person.role == 3) %>
          <%= button_to 'Send Password Reset', send_password_reset_person_path(@person), method: :post, class: "btn btn-secondary btn-lg" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    <div class="border border-danger p-4">
      <h4 class="mb-4 text-danger">Danger Zone</h4>
      <div class="d-flex" style="gap:1rem;" role="group">
        <%= link_to 'Declined', { action: "change_state", id: @person.id, state: 23 }, { class: 'btn btn-danger btn-lg' } %>
        <%= link_to 'Delete', @person, method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger btn-lg' %>
      </div>
    </div>
  </div>
</div>
